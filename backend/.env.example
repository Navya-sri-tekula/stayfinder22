PORT=5000
NODE_ENV=development

# Neon PostgreSQL (recommended for production and serverless deployments)
# Paste the pooled connection string from your Neon project.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Local fallback is used only when DATABASE_URL is not set and NODE_ENV is not production.
# DB_DIALECT=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=stayfinder_db
# DB_USER=root
# DB_PASSWORD=

# Generate a unique random secret with at least 32 characters.
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d

# Required only for property-owner registration; keep this value private.
OWNER_REGISTRATION_CODE=

# Neon Object Storage (S3-compatible) for persistent property image uploads.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=ap-southeast-1
STAYFINDER_STORAGE_BUCKET=stayfinder-images

# Comma-separated allowed frontend origins (optional; Vercel frontend proxies /api).
FRONTEND_URL=http://localhost:3000
